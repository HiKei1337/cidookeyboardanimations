{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.6.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "117",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://cidoo.illumipc.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extensionTitle__"
  },
  "commands": {
    "toggle-heart": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "__MSG_toggleDescription__"
    },
    "stop-heart": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_stopDescription__"
    }
  }
}
